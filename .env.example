# --- Required for real (non-mock) acquisition -----------------------------
TORBOX_API_KEY=
TMDB_API_KEY=              # v3 API key...
# TMDB_READ_ACCESS_TOKEN=  # ...or the v4 Read Access Token (preferred; only one needed)
PROWLARR_URL=          # your self-hosted Prowlarr, e.g. http://localhost:9696
PROWLARR_API_KEY=

# --- Required for YouTube upload (skip with --no-upload) -------------------
YOUTUBE_CLIENT_SECRETS= # path to client_secret.json
# YOUTUBE_TOKEN_PATH=   # optional; defaults to <repo>/storage/youtube_token.json
PRIVACY=unlisted

# --- Recap format ----------------------------------------------------------
MAX_PARTS=4
MAX_PART_SECONDS=180
PREFER_QUALITY=1080p-bluray

# --- Optional extras -------------------------------------------------------
# TOP_N_CANDIDATES=10            # optional; Prowlarr candidates to consider (default 10)
# NARRATION_LANGUAGE=English     # optional; recap narration language
# TTS_ENGINE=edge_tts            # optional; zero-config default
# TTS_VOICE_NAME=                # optional; defaults to config.toml ui.edge_voice_name
